{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug MinGW",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_windows/build_folder/out.exe",
            "cwd": "${workspaceFolder}",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",

            "miDebuggerPath": "C:/mingw64/bin/gdb.exe",

            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
